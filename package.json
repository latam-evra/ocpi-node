{
  "name": "@latam-evra/ocpi-client",
  "version": "0.4.0",
  "description": "Cliente Node.js/TypeScript para el Hub de roaming OCPI 2.3.0 de LATAM EV Roaming Alliance.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ocpi",
    "ev-charging",
    "roaming",
    "hub",
    "latam-evra"
  ],
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
